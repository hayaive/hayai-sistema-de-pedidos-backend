# ─────────────────────────────────────────────────────────────────────────────
# Copia este archivo a .env y rellena los valores. En Railway estas mismas
# claves se configuran como variables del servicio (no se sube ningún .env).
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos ────────────────────────────────────────────────────────────
# Un solo Postgres para los dos ambientes, separados por SCHEMA (decisión del
# coordinador: evita necesitar una segunda base física):
#   servicio de main  ->  ...?schema=public
#   servicio de test  ->  ...?schema=test
# `prisma migrate deploy` crea el schema si no existe (verificado), y además
# `npm run db:bootstrap` lo garantiza con un CREATE SCHEMA IF NOT EXISTS antes
# de migrar. Cada schema tiene su propia secuencia `sync_rev_seq`, así que los
# cursores de sincronización de test y prod son independientes.
DATABASE_URL="postgresql://usuario:clave@host:5432/railway?schema=public"

# Sólo la usan `prisma migrate dev` y `npm run db:drift` en local (crean y
# destruyen una base espejo). `prisma migrate deploy`, que es lo que corre en
# Railway, NO la necesita.
# ⚠ Para que `db:drift` no dé falsos positivos, el schema de ésta y el de
#   DATABASE_URL tienen que coincidir.
SHADOW_DATABASE_URL="postgresql://usuario:clave@host:5432/karelys_shadow?schema=public"

# Tamaño máximo del pool de conexiones (opcional, 10 por defecto).
# DATABASE_POOL_MAX=10

# ── Servidor ─────────────────────────────────────────────────────────────────
# Railway inyecta PORT; el servidor escucha siempre en 0.0.0.0.
PORT=3000
NODE_ENV=development

# Orígenes permitidos por CORS, separados por coma. El frontend vive en otro
# dominio, así que esto es obligatorio. Si la variable no está, el default son
# los dos servicios del frontend más localhost:
#   https://karelys-pedidos-production.up.railway.app
#   https://karelys-pedidos-test-production.up.railway.app
#   http://localhost   (cualquier puerto, para desarrollo)
# "http://localhost" en la lista habilita cualquier puerto de localhost y de
# 127.0.0.1: en desarrollo el puerto cambia según la herramienta.
CORS_ORIGINS="https://karelys-pedidos-production.up.railway.app,https://karelys-pedidos-test-production.up.railway.app,http://localhost"

# ── Autenticación ────────────────────────────────────────────────────────────
# Secretos DISTINTOS para access y refresh: si se filtra uno, no sirve para
# emitir el otro. Generar con: openssl rand -base64 48
# ⚠ Obligatorios con NODE_ENV=production (el arranque falla si faltan) y
#   DISTINTOS entre prod y test.
JWT_ACCESS_SECRET="cambiame"
JWT_REFRESH_SECRET="cambiame-tambien-y-distinto"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
# Días que un dispositivo puede operar sin poder revalidar contra el servidor.
OFFLINE_SESSION_MAX_DAYS=7

# ── Sincronización ───────────────────────────────────────────────────────────
# Ventana de reenvío del delta, en revisiones. Cubre la ventana en la que una
# transacción todavía sin commitear podría haberse "saltado" el cursor de un
# poll anterior. Ver ARCHITECTURE.md §El cursor rev.
SYNC_RESEND_WINDOW=200
# Tope de agregados por respuesta de GET /sync (el cliente vuelve a pedir con
# el cursor nuevo si `hasMore` es true).
SYNC_PAGE_LIMIT=500
# Días que se conservan los tombstones. Un dispositivo con un cursor más viejo
# que esto recibe 410 con `bootstrapRequired` y tiene que rehacer /bootstrap.
SYNC_TOMBSTONE_RETENTION_DAYS=90
# Días que se conserva la bitácora de idempotencia de mutaciones.
SYNC_MUTATION_RETENTION_DAYS=30

# ── Caché offline del cliente ────────────────────────────────────────────────
# Días de historia que /bootstrap manda al dispositivo. El histórico completo se
# consulta con los endpoints paginados, sólo en línea.
BOOTSTRAP_WINDOW_DAYS=30
BOOTSTRAP_CLOSURES_DAYS=90
BOOTSTRAP_AUDIT_LIMIT=200
# Días de historial de tasas. La vigente de cada fuente va siempre, aunque sea
# más antigua: sin ella un equipo no podría cobrar en Bs.
BOOTSTRAP_RATES_DAYS=30

# ── Negocio ──────────────────────────────────────────────────────────────────
# Zona con la que se calcula el día contable (cierre de caja). Se guarda también
# en company_settings.timezone; esta variable es el valor inicial del seed.
BUSINESS_TIMEZONE="America/Caracas"
# Job que trae la tasa oficial. Con el backend como único publicador, todos los
# dispositivos ven la misma tasa y un equipo offline la recibe al sincronizar.
RATES_FETCH_ENABLED=true
RATES_FETCH_CRON="0 */4 * * *"
RATES_API_URL="https://ve.dolarapi.com/v1"

# ── Semilla (npm run db:seed) ────────────────────────────────────────────────
# Usuario administrador inicial. La contraseña NO está en el código: sale de
# aquí. El default sólo vale para desarrollo y el seed ABORTA si se queda puesto
# con NODE_ENV=production.
# La semilla sólo escribe la contraseña al CREAR el usuario: si ya existe y le
# cambiaron la clave, correrla otra vez no se la revierte.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="cambiame-antes-de-desplegar"
SEED_ADMIN_EMAIL="admin@karelysdelicias.com"
